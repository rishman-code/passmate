EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# NOT bundled into the app -- only read locally by
# scripts/generate-all-explanations.js to pre-warm the AI explanation
# cache. The shipped app calls the Supabase Edge Function instead, which
# holds its own ANTHROPIC_API_KEY as a Supabase secret (see CLAUDE.md).
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key

EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key
